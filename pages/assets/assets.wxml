<view class="container">
  
  <view class="header-tabs-fixed">
    <scroll-view scroll-x class="header-tabs-scroll" enable-flex>
      <view class="h-tab {{currentType==='all'?'active':''}}" bindtap="switchType" data-type="all">全部</view>
      <view class="h-tab {{currentType==='银行存款'?'active':''}}" bindtap="switchType" data-type="银行存款">银行存款</view>
      <view class="h-tab {{currentType==='公募基金'?'active':''}}" bindtap="switchType" data-type="公募基金">公募基金</view>
      <view class="h-tab {{currentType==='股票/ETF'?'active':''}}" bindtap="switchType" data-type="股票/ETF">股票/ETF</view>
      <view class="h-tab {{currentType==='定期理财'?'active':''}}" bindtap="switchType" data-type="定期理财">定期理财</view>
    </scroll-view>
  </view>

  <view class="header-placeholder"></view>

  <view class="chart-section" wx:if="{{currentType !== 'all' && displayList.length > 0}}">
    <view class="chart-header-row">
      <view class="section-title">{{currentType}}透视</view>
      <view class="chart-sub-tabs">
        <view class="s-tab {{chartMode==='dist'?'active':''}}" bindtap="switchChartMode" data-mode="dist">分布</view>
        <view class="s-tab {{chartMode==='rate'?'active':''}}" bindtap="switchChartMode" data-mode="rate">年化榜</view>
        <view class="s-tab {{chartMode==='profit'?'active':''}}" bindtap="switchChartMode" data-mode="profit">盈亏榜</view>
      </view>
    </view>
    
    <view class="chart-container">
      <ec-canvas 
        id="mychart-dom-cat" 
        canvas-id="mychart-cat" 
        ec="{{ ec }}" 
        type="2d" 
        style="width: 100%; height: 400rpx; opacity: {{chartOpacity}}; transition: opacity 0.2s;"
      ></ec-canvas>
    </view>
  </view>

  <view class="sort-bar">
    <view class="sort-item {{sortBy==='balance'?'active':''}}" bindtap="switchSort" data-sort="balance">
      按余额 <text class="arrow" wx:if="{{sortBy==='balance'}}">↓</text>
    </view>
    <view class="sort-item {{sortBy==='rate'?'active':''}}" bindtap="switchSort" data-sort="rate">
      按收益率 <text class="arrow" wx:if="{{sortBy==='rate'}}">↓</text>
    </view>
    <view class="sort-item {{sortBy==='profit'?'active':''}}" bindtap="switchSort" data-sort="profit">
      按昨日收益 <text class="arrow" wx:if="{{sortBy==='profit'}}">↓</text>
    </view>
  </view>

  <view class="list-container">
    <block wx:for="{{displayList}}" wx:key="_id">
      <view class="asset-item" bindtap="goDetail" data-item="{{item}}">
        
        <view class="row-top">
          <text class="asset-name">{{item.name}}</text>
          <text wx:if="{{currentType==='all'}}" class="tag {{item.type==='银行存款'?'tag-gold':'tag-blue'}}">{{item.type}}</text>
        </view>

        <view class="row-bottom">
          <view class="detail-col">
            <text class="val">¥{{item.currentBalance}}</text>
            <text class="lbl">持有金额</text>
          </view>
          
          <view class="detail-col center">
            <text wx:if="{{item.type === '银行存款'}}" class="val gold">{{item.displayRate}}%</text>
            <text wx:else class="val {{item.displayRate >= 0 ? 'red' : 'green'}}">{{item.displayRate >= 0 ? '+':''}}{{item.displayRate}}%</text>
            <text class="lbl">{{item.type === '银行存款'?'年化利率':'今日涨跌'}}</text>
          </view>
          
          <view class="detail-col right">
            <text class="val {{item.dailyProfit >= 0 ? 'red' : 'green'}}">{{item.dailyProfit >= 0 ? '+':''}}{{item.dailyProfit}}</text>
            <text class="lbl">{{item.type === '银行存款'?'今日利息':'昨日盈亏'}}</text>
          </view>
        </view>

      </view>
    </block>
    
    <view wx:if="{{displayList.length === 0}}" class="empty-tip">
      暂无{{currentType === 'all' ? '' : currentType}}资产
    </view>
    
    <view style="height: 60rpx;"></view>
  </view>
</view>