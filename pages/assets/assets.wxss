/* pages/assets/assets.wxss */
page {
  background-color: #F5F7FA; /* 更柔和的浅灰背景 */
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  padding-bottom: 40rpx;
}

.container { 
  display: flex; 
  flex-direction: column; 
  min-height: 100vh;
}

/* 1. 顶部固定导航栏 (高颜值版) */
.header-tabs-fixed {
  position: fixed; 
  top: 0; 
  left: 0; 
  width: 100%; 
  z-index: 100;
  background: #fff; 
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03); /* 极轻的阴影 */
}

.header-tabs-scroll {
  display: flex; 
  white-space: nowrap; 
  height: 96rpx; 
  align-items: center;
  padding: 0 10rpx;
}

.h-tab {
  display: inline-block; 
  padding: 0 32rpx; 
  height: 96rpx; 
  line-height: 96rpx;
  font-size: 28rpx; 
  color: #666;
  position: relative; 
  transition: all 0.3s font-weight;
}

.h-tab.active { 
  color: #1A73E8; 
  font-weight: 700; 
  font-size: 30rpx; 
}

/* 选中态的小蓝条 */
.h-tab.active::after {
  content: ''; 
  position: absolute; 
  bottom: 12rpx; 
  left: 50%; 
  transform: translateX(-50%);
  width: 32rpx; 
  height: 6rpx; 
  background: #1A73E8; 
  border-radius: 4rpx;
}

/* 占位高度 */
.header-placeholder { height: 96rpx; }

/* 2. 排序筛选栏 (胶囊样式) */
.sort-bar {
  display: flex; 
  justify-content: space-between;
  padding: 24rpx 30rpx; 
  background: #F5F7FA; /* 与页面背景融合 */
  position: sticky; /* 吸顶效果 */
  top: 96rpx; /* 在 Header 下方 */
  z-index: 90;
}

.sort-item {
  flex: 1; 
  text-align: center; 
  font-size: 24rpx; 
  color: #666; 
  background: #fff;
  margin: 0 8rpx;
  padding: 12rpx 0;
  border-radius: 30rpx; /* 胶囊圆角 */
  border: 1rpx solid transparent;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sort-item:first-child { margin-left: 0; }
.sort-item:last-child { margin-right: 0; }

.sort-item.active { 
  color: #1A73E8; 
  background: #E8F0FE; /* 浅蓝背景 */
  border-color: rgba(26, 115, 232, 0.2);
  font-weight: 600;
}

.arrow { 
  font-size: 20rpx; 
  margin-left: 4rpx; 
  transform: scale(0.8);
}

/* 3. 图表分析区 (卡片化) */
.chart-section {
  margin: 20rpx 30rpx; 
  background: #fff; 
  border-radius: 24rpx; 
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.chart-header-row { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  margin-bottom: 24rpx; 
  padding: 0 10rpx;
}

.section-title { 
  font-size: 30rpx; 
  font-weight: 700; 
  color: #333; 
  border-left: 8rpx solid #1A73E8; 
  padding-left: 16rpx; 
}

/* 图表内部的小切换 */
.chart-sub-tabs { 
  display: flex; 
  background: #F0F2F5; 
  padding: 4rpx; 
  border-radius: 12rpx; 
}
.s-tab { 
  padding: 6rpx 20rpx; 
  font-size: 22rpx; 
  color: #666; 
  border-radius: 8rpx; 
  transition: all 0.2s; 
}
.s-tab.active { 
  background: #fff; 
  color: #1A73E8; 
  font-weight: 600; 
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05); 
}

.chart-container { 
  width: 100%; 
  height: 400rpx !important; 
  position: relative; 
  overflow: hidden; 
}
ec-canvas { width: 100%; height: 100%; display: block; }

/* 4. 列表容器 */
.list-container { 
  padding: 0 30rpx; 
  flex: 1;
}

/* 资产卡片项 (核心美化) */
.asset-item { 
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.02); /* 极简阴影 */
  position: relative;
}
.asset-item:active { background-color: #FAFAFA; transform: scale(0.995); transition: transform 0.1s;}

/* 卡片上部分：名称+标签 */
.row-top { 
  display: flex; 
  align-items: center; 
  margin-bottom: 24rpx; 
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F7F7F7;
}
.asset-name { 
  font-size: 32rpx; 
  font-weight: 600; 
  color: #222; 
  max-width: 450rpx; 
  overflow: hidden; 
  white-space: nowrap; 
  text-overflow: ellipsis; 
}
.tag { 
  font-size: 20rpx; 
  padding: 4rpx 12rpx; 
  border-radius: 8rpx; 
  margin-left: 16rpx; 
  font-weight: 500; 
  letter-spacing: 1rpx;
}
.tag-gold { background: #FFF8E1; color: #F57F17; }
.tag-blue { background: #E3F2FD; color: #1565C0; }

/* 卡片下部分：三列数据 */
.row-bottom { 
  display: flex; 
  justify-content: space-between; 
  align-items: center;
}
.detail-col { 
  display: flex; 
  flex-direction: column; 
}
.detail-col.center { align-items: center; }
.detail-col.right { align-items: flex-end; }

/* 数值样式 */
.val { 
  font-size: 32rpx; 
  font-weight: 700; 
  font-family: 'DIN', sans-serif; 
  color: #333; 
  margin-bottom: 8rpx; 
}
.lbl { font-size: 22rpx; color: #999; }

/* 颜色工具 */
.red { color: #F5222D; }
.green { color: #00B578; }
.gold { color: #FAAD14; }

.empty-tip { 
  text-align: center; 
  color: #AAA; 
  padding: 100rpx 0; 
  font-size: 28rpx; 
  background: #fff;
  border-radius: 24rpx;
  margin-top: 20rpx;
}