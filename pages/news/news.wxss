/* pages/news/news.wxss */
/* ... 顶部行情样式保持不变 (复用上一次的 ticker-wrap 部分) ... */
page { background-color: #FFFFFF; height: 100vh; display: flex; flex-direction: column; }
.container { display: flex; flex-direction: column; height: 100%; width: 100%; }
.ticker-wrap { background: #1F2126; padding-bottom: 16rpx; width: 100%; z-index: 10; display: flex; flex-direction: column; }
.status-bar { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 24rpx 0; margin-bottom: 10rpx; }
.market-label { font-size: 22rpx; color: #888; font-weight: 600; letter-spacing: 2rpx; }
.update-tip { font-size: 20rpx; color: #555; background: rgba(255,255,255,0.1); padding: 4rpx 10rpx; border-radius: 6rpx; }
.ticker-swiper { height: 130rpx; }
.ticker-row { display: flex; align-items: center; height: 100%; width: 100%; }
.idx-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
.idx-divider { width: 1rpx; height: 60rpx; background: rgba(255, 255, 255, 0.1); }
.idx-name { font-size: 22rpx; color: #AAA; margin-bottom: 6rpx; font-weight: 500; }
.idx-val { font-size: 36rpx; weight: bold; font-family: 'DIN Alternate', sans-serif; color: #FFFFFF; margin-bottom: 8rpx; line-height: 1; }
.idx-capsule { display: flex; align-items: center; justify-content: center; padding: 2rpx 12rpx; border-radius: 6rpx; min-width: 100rpx; }
.bg-red { background-color: #F54558; } .bg-green { background-color: #2EBD85; } 
.idx-rate { font-size: 22rpx; font-family: 'DIN Alternate', sans-serif; font-weight: 600; color: #FFFFFF; }

/* ✨✨✨ 2. 渠道滚动条 (Channel Bar) ✨✨✨ */
.channel-bar {
  height: 88rpx;
  background: #fff;
  border-bottom: 1rpx solid #F0F0F0;
  position: relative;
  width: 100%;
}
.channel-scroll {
  height: 100%;
  display: flex;
  white-space: nowrap;
  padding: 0 20rpx;
}
.c-tab {
  display: inline-block;
  padding: 0 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #666;
  position: relative;
  transition: all 0.2s;
}
.c-tab.active {
  color: #F85959; /* 今日头条红 */
  font-weight: 700;
  font-size: 34rpx;
  transform: scale(1.05);
}
/* 遮罩，提示右边还有 */
.channel-mask {
  position: absolute; right: 0; top: 0; bottom: 0; width: 40rpx;
  background: linear-gradient(to right, rgba(255,255,255,0), rgba(255,255,255,1));
  pointer-events: none;
}

/* 3. 列表区域 */
.news-scroll { flex: 1; height: 0; background: #fff; }
.news-list { padding: 0 30rpx; }

.news-item {
  display: flex;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
}
.news-item:active { background-color: #FAFAFA; }

.news-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-right: 24rpx;
}

.news-title {
  font-size: 34rpx; color: #222; font-weight: 500; line-height: 1.4;
  margin-bottom: 16rpx;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  text-align: justify;
}

.news-meta {
  display: flex; align-items: center; font-size: 22rpx; color: #999;
}
.meta-source { 
  margin-right: 16rpx; 
}
/* 来源高亮，显示出"多渠道" */
.source-highlight {
  color: #1A73E8;
  background: rgba(26, 115, 232, 0.08);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.meta-time { color: #CCC; }

/* 右侧图 (强制比例 3:2) */
.news-cover {
  width: 220rpx;
  height: 146rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  overflow: hidden;
  background: #F0F0F0;
}
.cover-img { width: 100%; height: 100%; background-color: #eee;}

.loading-state { text-align: center; padding: 60rpx 0; color: #CCC; font-size: 24rpx; }

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 100rpx;
}
.empty-img { width: 120rpx; height: 120rpx; margin-bottom: 20rpx; opacity: 0.5; }
.empty-text { font-size: 26rpx; color: #999; margin-bottom: 40rpx; }
.init-btn {
  background: #1A73E8;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 10rpx 60rpx;
  box-shadow: 0 4rpx 12rpx rgba(26, 115, 232, 0.3);
}