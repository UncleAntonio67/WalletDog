/* pages/detail/detail.wxss */
page {
  background-color: #f6f7f9;
  font-family: -apple-system, sans-serif;
  padding-bottom: 60rpx;
}

.container { padding: 30rpx; }

/* 1. 顶部卡片 (重构版) */
.header-card {
  background: linear-gradient(135deg, #1A73E8, #4285F4);
  color: #fff;
  padding: 40rpx;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 20rpx rgba(26, 115, 232, 0.3);
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
}

.header-card.bank-bg {
  background: linear-gradient(135deg, #F0B90B, #F7931A);
  box-shadow: 0 10rpx 20rpx rgba(240, 185, 11, 0.3);
}

/* 顶部：名字+代码 */
.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}
.name {
  font-size: 32rpx;
  font-weight: bold;
  max-width: 70%;
  line-height: 1.4;
}
.code-tag {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 中间：金额 */
.header-main { margin-bottom: 40rpx; }
.header-main .label { font-size: 24rpx; opacity: 0.8; margin-bottom: 10rpx; }
.header-main .amount { font-size: 60rpx; font-weight: bold; font-family: 'DIN', sans-serif; }

/* 底部：两列数据 */
.header-bottom {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.05); /* 轻微底色区分 */
  border-radius: 16rpx;
  padding: 20rpx;
}
.data-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.d-val { font-size: 32rpx; font-weight: bold; margin-bottom: 6rpx; }
.d-lbl { font-size: 22rpx; opacity: 0.8; }
.header-bottom .divider { width: 1rpx; height: 30rpx; background: rgba(255,255,255,0.3); }

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.card-title {
  font-size: 30rpx; font-weight: bold; color: #333;
  margin-bottom: 24rpx; border-left: 8rpx solid #1A73E8; padding-left: 16rpx;
}

/* ✨✨✨ 图表容器样式 (关键：必须有固定高度) ✨✨✨ */
.chart-container {
  width: 100%;
  height: 500rpx; /* 强制高度 */
  display: block;
}
ec-canvas { width: 100%; height: 100%; }

.chart-header { display: flex; justify-content: center; margin-bottom: 20rpx; }
.tab-item {
  padding: 10rpx 30rpx; font-size: 26rpx; color: #666;
  border-radius: 30rpx; margin: 0 10rpx; transition: all 0.2s;
}
.tab-item.active { background: #E8F0FE; color: #1A73E8; font-weight: bold; }
.chart-tip { font-size: 20rpx; color: #ccc; text-align: right; margin-top: 10rpx; }

/* 成本分析 */
.cost-comparison { display: flex; align-items: center; justify-content: space-around; padding: 20rpx 0; }
.cost-item { display: flex; flex-direction: column; align-items: center; }
.c-val { font-size: 36rpx; font-weight: bold; margin-bottom: 8rpx; }
.c-lbl { font-size: 24rpx; color: #999; }
.vs-icon { font-size: 24rpx; color: #ddd; font-weight: bold; font-style: italic; }
.cost-tip { text-align: center; font-size: 26rpx; color: #666; margin-top: 20rpx; background: #f9f9f9; padding: 16rpx; border-radius: 12rpx; }

/* 列表行 */
.row { display: flex; justify-content: space-between; margin-bottom: 20rpx; font-size: 28rpx; color: #555; }
.big-row { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #eee; align-items: center; }
.total-label { font-weight: bold; color: #333; }
.amount-text { font-size: 44rpx; font-weight: bold; color: #F0B90B; font-family: 'DIN', sans-serif; }

/* 颜色 */
.red { color: #EA4335; }
.green { color: #34A853; }
.red-bg { color: #fff; background: #EA4335; padding: 0 8rpx; border-radius: 6rpx; }
.green-bg { color: #fff; background: #34A853; padding: 0 8rpx; border-radius: 6rpx; }

/* 底部按钮 */
.footer-action { padding: 20rpx 0; }
.add-btn { background: #1A73E8; color: #fff; border-radius: 50rpx; font-size: 32rpx; font-weight: bold; }

/* 存款进度条 */
.progress-box { padding: 10rpx 0 20rpx; }
.dates, .tips { display: flex; justify-content: space-between; font-size: 24rpx; color: #999; margin-bottom: 10rpx; }
.bar-bg { width: 100%; height: 16rpx; background: #f0f0f0; border-radius: 10rpx; overflow: hidden; }
.bar-fill { height: 100%; background: linear-gradient(90deg, #F0B90B, #F7931A); border-radius: 10rpx; }