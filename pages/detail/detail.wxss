/* pages/detail/detail.wxss */
.container { padding: 30rpx; padding-bottom: 60rpx; }

/* 顶部卡片 */
.header-card {
  background: linear-gradient(135deg, #1A73E8, #0D47A1);
  color: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 20rpx rgba(26, 115, 232, 0.3);
}
.name { font-size: 36rpx; font-weight: bold; margin-bottom: 30rpx; }
.code { font-size: 26rpx; opacity: 0.8; font-weight: normal; }

.balance-row { text-align: center; margin-bottom: 40rpx; }
.balance-row .label { font-size: 26rpx; opacity: 0.8; margin-bottom: 10rpx; }
.balance-row .amount { font-size: 64rpx; font-weight: bold; }

.profit-row { display: flex; justify-content: space-between; border-top: 1rpx solid rgba(255,255,255,0.2); padding-top: 20rpx; }
.profit-row .item { display: flex; flex-direction: column; align-items: center; width: 33%; }
.p-label { font-size: 24rpx; opacity: 0.7; margin-bottom: 8rpx; }
.p-value { font-size: 30rpx; font-weight: 500; }

/* 涨跌颜色 (在深色背景下) */
.p-value.red { color: #FFCDD2; }
.p-value.green { color: #C8E6C9; }

/* 通用卡片 */
.card { background: #fff; border-radius: 20rpx; padding: 30rpx; margin-bottom: 30rpx; }
.card-title { font-size: 32rpx; font-weight: bold; margin-bottom: 20rpx; border-left: 8rpx solid #1A73E8; padding-left: 20rpx; }

/* 走势图 */
.fund-chart { 
  width: 100%; 
  height: 400rpx; /* 给一个固定高度 */
  display: block; 
  margin: 20rpx 0; 
}
.chart-tip { text-align: center; font-size: 22rpx; color: #999; }
.no-chart-tip { text-align: center; color: #ccc; padding: 50rpx 0; }

/* 详情行 */
.row { display: flex; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid #f5f5f5; font-size: 30rpx; color: #333; }
.row:last-child { border-bottom: none; }

/* 普通红绿文字 */
.red { color: #E74C3C; font-weight: bold; }
.green { color: #2ECC71; font-weight: bold; }