/* 容器微调 */
.container {
  padding-bottom: 120rpx; /* 给底部按钮留出空间 */
}

/* 1. 顶部蓝色卡片 */
.header-card {
  margin: 20rpx;
  background: linear-gradient(135deg, #1A73E8, #0D47A1); /* 财富蓝渐变 */
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  color: #fff;
  box-shadow: 0 10rpx 20rpx rgba(26, 115, 232, 0.3);
}

.label { font-size: 26rpx; opacity: 0.9; }
.total-amount { font-size: 64rpx; font-weight: bold; margin: 16rpx 0; }
.profit-row { font-size: 28rpx; display: flex; align-items: center; }
.profit-row .text-up { color: #FFCDD2; font-weight: 500; } 
.profit-row .text-down { color: #C8E6C9; font-weight: 500; }

/* 2. 图表区域 */
.chart-container {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 0;
}

/* CSS 饼图核心代码 */
.pie-chart {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  /* 颜色比例：30%, 45%, 20%, 5% */
  background: conic-gradient(
    #1A73E8 0% 30%, 
    #FF9800 30% 75%, 
    #2ECC71 75% 95%, 
    #9C27B0 95% 100%
  );
  position: relative;
}
.pie-chart::after {
  content: "";
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 120rpx; height: 120rpx;
  background: #fff;
  border-radius: 50%;
}

.legend { font-size: 24rpx; color: #666; }
.legend-item { display: flex; align-items: center; margin-bottom: 8rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 12rpx; }
.color-1 { background: #1A73E8; }
.color-2 { background: #FF9800; }
.color-3 { background: #2ECC71; }
.color-4 { background: #9C27B0; }

/* 3. 排行榜样式 */
.card-title { font-size: 32rpx; font-weight: bold; margin-bottom: 20rpx; border-left: 8rpx solid #1A73E8; padding-left: 20rpx; }
.ranking-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.ranking-item:last-child { border-bottom: none; }
/* 修改 ranking-item 布局 */
.income-box { text-align: right; }
.income-val { font-size: 32rpx; font-weight: bold; }
.total-bal { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.rate { font-size: 24rpx; margin-top: 6rpx; }
.rank-num { width: 50rpx; font-size: 36rpx; color: #ccc; font-style: italic; font-weight: bold; }
.rank-num.top-three { color: #FF9800; } 

.product-info { flex: 1; display: flex; flex-direction: column; }
.product-info .name { font-size: 30rpx; color: #333; margin-bottom: 4rpx; }
.product-info .rate { font-size: 22rpx; color: #999; }

.income { font-size: 32rpx; font-weight: bold; }
/* 这里使用我们在app.wxss定义的全局变量颜色 */
.text-up { color: var(--up); }
.text-down { color: var(--down); }

/* 4. 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx; bottom: 40rpx;
  width: 100rpx; height: 100rpx;
  background: #fff; /* 改为白色背景 */
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(26, 115, 232, 0.4);
  display: flex; justify-content: center; align-items: center;
  z-index: 100;
}
.plus-icon {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
