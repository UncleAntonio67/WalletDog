/* pages/index/index.wxss */
page {
  background-color: #f6f7f9;
  padding-bottom: 40rpx;
  /* 统一字体，防止显示乱码 */
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
}

.container {
  padding: 30rpx;
}

/* 1. 顶部总览卡片 */
.header-card {
  background: linear-gradient(135deg, #1A73E8, #4285F4);
  color: #fff;
  padding: 40rpx;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 20rpx rgba(26, 115, 232, 0.3);
  margin-bottom: 30rpx;
}

.total-label {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.total-amount {
  font-size: 64rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  font-family: 'DIN', sans-serif; /* 尝试使用数字字体 */
}

.today-profit {
  background: rgba(255, 255, 255, 0.15);
  display: inline-flex;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  align-items: center;
}

.profit-val {
  margin-left: 10rpx;
  font-weight: bold;
}
.profit-val.red { color: #FFCDD2; }
.profit-val.green { color: #C8E6C9; }


/* 通用卡片样式 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #1A73E8;
  padding-left: 16rpx;
}

/* 2. 图表区域 (关键：必须有高度) */
.chart-box {
  width: 100%;
  height: 400rpx; /* ✨✨✨ 确保这里有高度，否则饼图不显示 */
  position: relative;
}

ec-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* 3. 资产列表样式 */
.asset-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

/* 排名数字 */
.rank-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #DDD;
  width: 50rpx;
  font-style: italic;
  text-align: center;
  margin-right: 16rpx;
}
.asset-item:nth-child(1) .rank-num { color: #F0B90B; } /* 金 */
.asset-item:nth-child(2) .rank-num { color: #AAA; }    /* 银 */
.asset-item:nth-child(3) .rank-num { color: #B8741A; } /* 铜 */

/* 中间信息区 */
.info-box {
  flex: 1;
  display: flex;
  flex-direction: column; /* 上下排列 */
  justify-content: center;
}

/* 第一行：名字 */
.asset-row-top {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.asset-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag {
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  font-weight: normal;
  white-space: nowrap;
}
.tag-gold { background: #FFF6E0; color: #F0B90B; }
.tag-blue { background: #E8F0FE; color: #1A73E8; }

/* 第二行：数据 */
.asset-row-bottom {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.divider {
  margin: 0 16rpx;
  color: #eee;
  font-size: 20rpx;
}

.profit-label {
  margin-right: 6rpx;
}

.profit-num {
  font-weight: 500;
}

/* 颜色工具类 */
.red { color: #EA4335; }
.green { color: #34A853; }
.gold { color: #F0B90B; }
.rate-val.red { color: #EA4335; }
.rate-val.green { color: #34A853; }

/* 右侧金额区 */
.amount-box {
  text-align: right;
  margin-left: 20rpx;
}

.balance {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  font-family: 'DIN', sans-serif;
}

.arrow {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 4rpx;
}

.line {
  height: 1rpx;
  background: #f5f5f5;
  margin-left: 80rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
  font-size: 28rpx;
}