/* pages/index/index.wxss */
page {
  background-color: #f6f7f9;
  padding-bottom: 40rpx;
  font-family: -apple-system, sans-serif;
}

.container { padding: 30rpx; }

/* 头部卡片 */
.header-card {
  background: linear-gradient(135deg, #1A73E8, #4285F4);
  color: #fff;
  padding: 40rpx;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 20rpx rgba(26, 115, 232, 0.3);
  margin-bottom: 30rpx;
}
.total-label { font-size: 26rpx; opacity: 0.9; margin-bottom: 12rpx; }
.total-amount { font-size: 64rpx; font-weight: bold; margin-bottom: 30rpx; font-family: 'DIN', sans-serif; }
.today-profit { background: rgba(255, 255, 255, 0.15); display: inline-flex; padding: 10rpx 24rpx; border-radius: 30rpx; font-size: 26rpx; align-items: center; }
.profit-val { margin-left: 10rpx; font-weight: bold; }
.profit-val.red { color: #FFCDD2; }
.profit-val.green { color: #C8E6C9; }

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #1A73E8;
  padding-left: 16rpx;
}

/* ✨✨✨ 图表容器：高度必须强制指定 ✨✨✨ */
.chart-container {
  width: 100%;
  height: 400rpx; 
  position: relative;
}

ec-canvas {
  width: 100%;
  height: 100%;
}

/* 列表样式 */
.asset-item { display: flex; align-items: center; padding: 24rpx 0; }

.rank-num {
  font-size: 36rpx; font-weight: bold; color: #DDD; width: 40rpx;
  font-style: italic; text-align: center; margin-right: 16rpx;
}
.asset-item:nth-child(1) .rank-num { color: #F0B90B; }
.asset-item:nth-child(2) .rank-num { color: #AAA; }
.asset-item:nth-child(3) .rank-num { color: #B8741A; }

.info-box { flex: 1; display: flex; flex-direction: column; }

.row-top { display: flex; align-items: center; margin-bottom: 12rpx; }
.asset-name { font-size: 30rpx; font-weight: 600; color: #333; max-width: 320rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.tag { font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 6rpx; margin-left: 12rpx; font-weight: normal; }
.tag-gold { background: #FFF6E0; color: #F0B90B; }
.tag-blue { background: #E8F0FE; color: #1A73E8; }

/* 数据行对齐修复 */
.row-bottom { display: flex; align-items: center; }

.data-block { display: flex; align-items: baseline; }
.lbl { font-size: 22rpx; color: #999; margin-right: 8rpx; }
.val { font-size: 26rpx; font-weight: 500; font-family: 'DIN', sans-serif; }

.divider { width: 1rpx; height: 20rpx; background: #EEE; margin: 0 24rpx; }

.red { color: #EA4335; }
.green { color: #34A853; }
.gold { color: #F0B90B; }

.amount-box { text-align: right; margin-left: 20rpx; }
.balance { font-size: 32rpx; font-weight: bold; color: #333; font-family: 'DIN', sans-serif; }
.arrow { font-size: 24rpx; color: #ccc; margin-top: 4rpx; }

.line { height: 1rpx; background: #f5f5f5; margin-left: 80rpx; }
.empty-tip { text-align: center; color: #999; padding: 40rpx 0; font-size: 28rpx; }