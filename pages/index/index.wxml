<view class="container">
  
  <view class="header-card">
    <view class="total-label">总资产 (元)</view>
    <view class="total-amount">{{totalAsset}}</view>
    <view class="today-profit">
      <text>昨日收益</text>
      <text class="profit-val {{totalDayProfit.includes('-')?'green':'red'}}">{{totalDayProfit}}</text>
    </view>
  </view>

  <view class="card chart-card">
    <view class="card-title">资产分布</view>
    <view class="chart-box">
      <ec-canvas id="mychart-dom-pie" canvas-id="mychart-pie" ec="{{ ec }}"></ec-canvas>
    </view>
  </view>

  <view class="card list-card">
    <view class="card-title">资产列表 (按余额)</view>
    
    <view class="asset-list">
      <block wx:for="{{assetList}}" wx:key="_id">
        <navigator url="/pages/detail/detail?assetStr={{item}}" class="asset-item">
          
          <view class="rank-num">{{index + 1}}</view>

          <view class="info-box">
            <view class="asset-row-top">
              <text class="asset-name">{{item.name}}</text>
              <text class="tag {{item.type==='银行存款'?'tag-gold':'tag-blue'}}">{{item.type}}</text>
            </view>
            
            <view class="asset-row-bottom">
              
              <text wx:if="{{item.type === '银行存款'}}" class="rate-val gold">年化 {{item.displayRate}}%</text>
              <text wx:else class="rate-val {{item.displayRate >= 0 ? 'red' : 'green'}}">
                {{item.displayRate >= 0 ? '+' : ''}}{{item.displayRate}}%
              </text>
              
              <text class="divider">|</text>
              
              <text class="profit-label">{{item.type==='银行存款' ? '日息' : '昨日'}}</text>
              <text class="profit-num {{item.isPositive ? 'red' : 'green'}}">
                {{item.dailyProfit > 0 ? '+' : ''}}{{item.dailyProfit}}
              </text>
            </view>
          </view>

          <view class="amount-box">
            <view class="balance">¥ {{item.currentBalance}}</view>
            <view class="arrow">></view>
          </view>

        </navigator>
        <view class="line" wx:if="{{index < assetList.length - 1}}"></view>
      </block>
      
      <view wx:if="{{assetList.length === 0}}" class="empty-tip">
        暂无资产，快去记一笔吧
      </view>
    </view>
  </view>

</view>