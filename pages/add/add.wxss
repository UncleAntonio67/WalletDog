/* pages/add/add.wxss */
.container { padding: 30rpx; background: #F6F7F9; min-height: 100vh; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02);
}

.title {
  font-size: 28rpx;
  color: #999;
  padding: 30rpx 0 10rpx;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 10rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 35rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}
.form-item:last-child { border-bottom: none; }

.label { width: 160rpx; color: #333; font-weight: 500; }
input { flex: 1; color: #333; }
.picker-value { flex: 1; color: #333; }

.status {
  font-size: 24rpx; color: #1A73E8;
}

.result-box {
  background: #E8F0FE;
  padding: 20rpx;
  border-radius: 8rpx;
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
  font-size: 28rpx;
  color: #1A73E8;
}
.highlight { font-weight: bold; }

.save-btn {
  margin-top: 60rpx;
  background: #1A73E8;
  color: #fff;
  border-radius: 50rpx;
  font-weight: bold;
}