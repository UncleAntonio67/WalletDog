/* pages/add/add.wxss */
.container { padding: 30rpx; }
.form-group { background: #fff; border-radius: 12rpx; padding: 0 30rpx; }

.form-item {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  padding: 30rpx 0;
  font-size: 30rpx;
}
.form-item:last-child { border-bottom: none; }

.label { width: 180rpx; color: #333; }

/* 修复 Picker 样式，让它撑开 */
picker { flex: 1; }
.picker-inner {
  display: flex;
  justify-content: space-between;
  color: #333;
}
.arrow { color: #ccc; }

input { flex: 1; color: #333; }

.save-btn {
  margin-top: 60rpx;
  background: #1A73E8;
  color: #fff;
  border-radius: 50rpx;
}
.tips { margin-top: 30rpx; font-size: 24rpx; color: #999; line-height: 1.6; }