/* 页面容器 */
.container {
  padding: 30rpx;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 0 30rpx; /* 上下padding由item撑开 */
  margin-bottom: 40rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: bold;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  color: #333;
}

/* 表单行 */
.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f9f9f9;
  font-size: 30rpx;
}
.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 180rpx;
  color: #333;
}

.input {
  flex: 1;
  text-align: right;
  color: #333;
  font-weight: 500;
}

.placeholder {
  color: #ccc;
  font-weight: normal;
}

/* 选择器样式 */
.picker {
  flex: 1;
  text-align: right;
  color: #333;
}
.arrow {
  color: #ccc;
  margin-left: 10rpx;
  font-family: monospace; /* 防止箭头字体差异 */
}

/* 按钮样式 */
.save-btn {
  background: #1A73E8;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  padding: 20rpx 0;
  box-shadow: 0 10rpx 20rpx rgba(26, 115, 232, 0.3);
}
.save-btn:active {
  background: #1558B0; /* 点击变深色 */
}